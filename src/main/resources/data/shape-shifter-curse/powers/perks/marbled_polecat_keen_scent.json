{
  "type": "apoli:multiple",
  "timer": {
    "type": "apoli:resource",
    "min": 0,
    "max": 60,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },
  "charge": {
    "type": "apoli:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "apoli:if_else",
      "condition": {
        "type": "apoli:and",
        "conditions": [
          {
            "type": "apoli:sneaking"
          },
          {
            "type": "apoli:moving",
            "inverted": true
          }
        ]
      },
      "if_action": {
        "type": "apoli:change_resource",
        "resource": "shape-shifter-curse:perks/marbled_polecat_keen_scent_timer",
        "change": 1
      },
      "else_action": {
        "type": "apoli:set_resource",
        "resource": "shape-shifter-curse:perks/marbled_polecat_keen_scent_timer",
        "value": 0
      }
    }
  },
  "glow": {
    "type": "apoli:entity_glow",
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "apoli:and",
          "conditions": [
            {
              "type": "apoli:sneaking"
            },
            {
              "type": "apoli:moving",
              "inverted": true
            }
          ]
        },
        {
          "type": "apoli:resource",
          "resource": "shape-shifter-curse:perks/marbled_polecat_keen_scent_timer",
          "comparison": ">=",
          "compare_to": 60
        }
      ]
    },
    "bientity_condition": {
      "type": "apoli:distance",
      "comparison": "<=",
      "compare_to": 8
    },
    "red": 1,
    "green": 0.5,
    "blue": 0,
    "use_teams": false
  }
}
